# Kisan Alert AI Configuration
# In production, change all passwords and secret keys

# Database configuration
DATABASE_URL=sqlite:///./kisan_alert.db

# Security
JWT_SECRET_KEY=replace_this_with_a_secure_long_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini AI (Optional - will fallback to local mocks if not provided)
GEMINI_API_KEY=

# App Environment (development/production)
ENV=development
PORT=8000
